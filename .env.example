NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Flutterwave ----------------------------------------------------------
# Card checkout only appears when both keys are set.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Any random string you choose. Paste the SAME value into
# Flutterwave > Settings > Webhooks > Secret hash, or every webhook is rejected
# and no order is ever marked paid.
FLUTTERWAVE_SECRET_HASH=
NEXT_PUBLIC_APP_URL=https://afunwa-hairline.vercel.app
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
# Optional: protects /api/keep-alive. Vercel cron sends it automatically.
CRON_SECRET=

# --- Single-store launch flags -------------------------------------------
# Vendor browsing (Find Vendors tab, Stores search filter). Turn on when there
# is more than one store worth browsing.
NEXT_PUBLIC_ENABLE_VENDOR_DISCOVERY=false
# Lets any signed-in buyer open their own store. Keep false until we want
# other vendors selling here.
NEXT_PUBLIC_ENABLE_SELLER_SIGNUP=false
# Comma separated emails that keep seller access while signup is closed.
# UI lock only — it ships in the client bundle, so Supabase RLS is the real gate.
NEXT_PUBLIC_SELLER_EMAILS=

# --- Carrier rate APIs -----------------------------------------------------
# Live shipping quotes. All server-side: a courier key in the client bundle is
# anyone's to spend. Leave any of them blank and that carrier falls back to the
# flat rate you set on the store, which is what happens today.
#
# DHL Express — needs an active DHL Express account, then request MyDHL API
# credentials on developer.dhl.com. The account number is the 9-digit one.
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
# Leave BLANK for live production rates, which is the default. Set to true
# only if you deliberately want DHL's sandbox (capped at 500 calls a day and
# returning made-up prices).
DHL_TEST_MODE=

# Topship — email tech@topship.africa for keys.
TOPSHIP_API_KEY=

# GIG Logistics — request access via giglogistics.com/developer.
GIG_API_KEY=

# --- PayPal -----------------------------------------------------------------
# Server-side. PayPal cannot settle naira, so orders are presented in US
# dollars converted at the same live rate the shop displays prices with.
# Leave blank and the PayPal option does not appear at checkout.
#
# Note for Nigeria: a standard PayPal Business account still cannot receive
# here. The route as of 2026 is PayPal's partnership with Paga.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" (default) or "sandbox".
PAYPAL_ENVIRONMENT=
# From Dashboard > Webhooks. Without it every webhook is rejected and no
# PayPal order is ever marked paid.
PAYPAL_WEBHOOK_ID=

# --- Terminal Africa (recommended) ------------------------------------------
# One self-serve key that quotes DHL, FedEx, Aramex and the Nigerian local
# couriers at once, and charges the cheapest. No account manager, no contract:
# sign up at dashboard.terminal.africa and generate a key under Settings.
# Covers Africa and Europe from the same call.
TERMINAL_API_KEY=
# Required by their rates call. Copy a packaging id from the same dashboard.
TERMINAL_PACKAGING_ID=
# "sandbox" while testing, blank for live.
TERMINAL_ENVIRONMENT=
