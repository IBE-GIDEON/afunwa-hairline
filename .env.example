NEXT_PUBLIC_SUPABASE_URL=...
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...

# --- Paystack ---------------------------------------------------------------
# Card and bank transfer checkout. The card option only appears when the
# public key is set. Set both keys in production.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=...
# Server-side only. Also verifies webhook signatures.
PAYSTACK_SECRET_KEY=...
# In Paystack > Settings > Webhooks, point the URL at
# https://<your-domain>/api/paystack/webhook
NEXT_PUBLIC_APP_URL=...
NEXT_PUBLIC_ENABLE_DEMO_MODE=...
# Optional: protects /api/keep-alive. Vercel cron sends it automatically.
CRON_SECRET=...

# --- Admin ----------------------------------------------------------------
# Comma separated emails that can open /admin/delivery to set delivery prices.
# Server only. Use the same email you sign in with.
ADMIN_EMAILS=...

# Delivery prices per country are set in the app at /admin/delivery, not here.
# Run supabase/delivery-prices.sql once before using it.

# --- Single-store launch flags -------------------------------------------
# Vendor browsing (Find Vendors tab, Stores search filter). Turn on when there
# is more than one store worth browsing.
NEXT_PUBLIC_ENABLE_VENDOR_DISCOVERY=...
# Lets any signed-in buyer open their own store. Keep false until we want
# other vendors selling here.
NEXT_PUBLIC_ENABLE_SELLER_SIGNUP=...
# Comma separated emails that keep seller access while signup is closed.
# UI lock only — it ships in the client bundle, so Supabase RLS is the real gate.
NEXT_PUBLIC_SELLER_EMAILS=...
